---
import { type CollectionEntry, getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import {
	MODALITY_LABELS,
	RELEASE_TYPE_COLORS,
	RELEASE_TYPE_LABELS,
} from '../../data/vendor-config';
import { getDeck } from '../../lib/site';
import {
	getModelHref,
	getRelatedArticleHref,
	getReleaseIso,
	getReleaseShortLabel,
	getVendorColor,
	sortModelsByDate,
} from '../../lib/models';
import { buildWebsiteJsonLd } from '../../lib/structuredData';

export async function getStaticPaths() {
	const models = await getCollection('models');
	const posts = await getCollection('posts');
	const postBySlug = new Map(posts.map((p) => [p.id, p]));
	return models.map((entry) => {
		const familyMates = sortModelsByDate(
			models.filter(
				(m) =>
					m.id !== entry.id &&
					m.data.family === entry.data.family &&
					m.data.vendor === entry.data.vendor,
			),
		).slice(0, 8);
		const article = entry.data.articleSlug
			? postBySlug.get(entry.data.articleSlug) ?? null
			: null;
		return {
			params: { id: entry.id },
			props: { entry, familyMates, article },
		};
	});
}

interface Props {
	entry: CollectionEntry<'models'>;
	familyMates: CollectionEntry<'models'>[];
	article: CollectionEntry<'posts'> | null;
}

const { entry, familyMates, article } = Astro.props;
const data = entry.data;
const articleHref = getRelatedArticleHref(entry);
const vendorColor = getVendorColor(data.vendor);

const description = `${data.vendor} · ${data.family} · ${data.name}: ${data.notes}`;

const jsonLd = buildWebsiteJsonLd({
	title: `${data.name} — ${SITE_TITLE}`,
	description,
	path: `/models/${entry.id}/`,
});

// Парсим benchmark scores в число для прогресс-баров (если возможно).
function benchmarkPercent(score: string): number | null {
	const m = score.match(/(\d+(?:\.\d+)?)/);
	if (!m) return null;
	const n = parseFloat(m[1]);
	if (Number.isNaN(n)) return null;
	if (n <= 1.5) return Math.min(n * 100, 100);
	if (n <= 100) return n;
	return Math.min(n / 10, 100);
}
---

<!doctype html>
<html lang="ru">
	<head>
		<BaseHead
			title={`${data.name} — ${SITE_TITLE}`}
			description={description}
			jsonLd={jsonLd}
		/>
	</head>
	<body>
		<Header />
		<main class="model-detail container">
			<a class="model-detail__back" href="/models/">← Все релизы</a>

			<header class="model-detail__hero">
				<div class="model-detail__head">
					<span
						class="model-detail__pill"
						style={`background:${vendorColor}`}
					>
						{data.vendor}
					</span>
					<span
						class="model-detail__type"
						style={`color:${RELEASE_TYPE_COLORS[data.releaseType]}`}
					>
						{RELEASE_TYPE_LABELS[data.releaseType]}
					</span>
					{data.status !== 'live' && (
						<span class="model-detail__status">
							{data.status === 'restricted' ? 'Ограниченный доступ' : 'Снят с поддержки'}
						</span>
					)}
				</div>
				<h1>{data.name}</h1>
				<div class="model-detail__family">{data.family}</div>
				<time class="model-detail__date" datetime={getReleaseIso(entry)}>
					Релиз — {getReleaseShortLabel(entry)}
				</time>
			</header>

			<section class="model-detail__facts">
				{data.modality.length > 0 && (
					<div class="fact">
						<span class="fact__label">Modality</span>
						<span class="fact__value">
							{data.modality.map((m) => MODALITY_LABELS[m] || m).join(' · ')}
						</span>
					</div>
				)}
				{data.contextWindow && (
					<div class="fact">
						<span class="fact__label">Контекст</span>
						<span class="fact__value">{data.contextWindow.toLocaleString('ru-RU')} токенов</span>
					</div>
				)}
				{data.pricing && (
					<div class="fact">
						<span class="fact__label">Цена</span>
						<span class="fact__value">
							in {data.pricing.input} · out {data.pricing.output}
						</span>
					</div>
				)}
			</section>

			{data.benchmarks && data.benchmarks.length > 0 && (
				<section class="model-detail__benchmarks" aria-label="Бенчмарки">
					<h2>Бенчмарки</h2>
					<ul>
						{data.benchmarks.map((b) => {
							const pct = benchmarkPercent(b.score);
							return (
								<li>
									<div class="bench-line">
										<span class="bench-line__name">{b.name}</span>
										<span class="bench-line__score">{b.score}</span>
									</div>
									{pct !== null && (
										<div class="bench-bar">
											<span class="bench-bar__fill" style={`width:${pct}%; background:${vendorColor}`}></span>
										</div>
									)}
								</li>
							);
						})}
					</ul>
				</section>
			)}

			<section class="model-detail__notes">
				<h2>Что важно</h2>
				<p>{data.notes}</p>
			</section>

			{article && articleHref && (
				<section class="model-detail__article">
					<span class="model-detail__article-kicker">Наш разбор</span>
					<a class="model-detail__article-card" href={articleHref}>
						<h3>{article.data.title}</h3>
						<p>{getDeck(article)}</p>
						<span class="model-detail__article-cta">Читать →</span>
					</a>
				</section>
			)}

			<section class="model-detail__source">
				<h2>Первоисточник</h2>
				<a href={data.sourceUrl} target="_blank" rel="noopener" class="model-detail__source-link">
					{data.sourceUrl}
				</a>
			</section>

			{familyMates.length > 0 && (
				<section class="model-detail__family-section">
					<h2>Соседи по семье</h2>
					<ul class="family-list">
						{familyMates.map((m) => (
							<li>
								<a href={getModelHref(m)} class="family-item">
									<span class="family-item__name">{m.data.name}</span>
									<time datetime={getReleaseIso(m)} class="family-item__date">
										{getReleaseShortLabel(m)}
									</time>
								</a>
							</li>
						))}
					</ul>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.model-detail {
		padding-top: 24px;
		padding-bottom: 64px;
		max-width: 820px;
	}
	.model-detail__back {
		display: inline-block;
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 13px;
		color: var(--violet-600);
		text-decoration: none;
		margin-bottom: 18px;
	}
	.model-detail__back:hover {
		text-decoration: underline;
	}
	.model-detail__hero {
		margin-bottom: 28px;
	}
	.model-detail__head {
		display: flex;
		gap: 10px;
		flex-wrap: wrap;
		align-items: center;
		margin-bottom: 14px;
	}
	.model-detail__pill {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 4px 12px;
		border-radius: 999px;
		color: #fff;
	}
	.model-detail__type {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
	}
	.model-detail__status {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.05em;
		text-transform: uppercase;
		padding: 3px 10px;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--ink-500);
	}
	.model-detail__hero h1 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 38px;
		line-height: 1.15;
		letter-spacing: -0.025em;
		color: var(--ink-900);
		margin: 0 0 8px;
	}
	.model-detail__family {
		font-family: var(--font-body);
		font-size: 16px;
		color: var(--ink-700);
		margin-bottom: 6px;
	}
	.model-detail__date {
		font-family: var(--font-body);
		font-size: 14px;
		color: var(--ink-500);
	}

	.model-detail__facts {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 14px;
		padding: 18px 22px;
		background: var(--paper-2);
		border-radius: 12px;
		margin-bottom: 28px;
	}
	.fact {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.fact__label {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--ink-500);
	}
	.fact__value {
		font-family: var(--font-body);
		font-size: 15px;
		color: var(--ink-900);
	}

	.model-detail h2 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
		color: var(--ink-900);
		margin: 0 0 12px;
	}
	.model-detail section {
		margin-bottom: 28px;
	}

	.model-detail__benchmarks ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.bench-line {
		display: flex;
		justify-content: space-between;
		font-family: var(--font-body);
		font-size: 14px;
	}
	.bench-line__name {
		color: var(--ink-700);
	}
	.bench-line__score {
		color: var(--ink-900);
		font-weight: 700;
		font-family: var(--font-mono);
	}
	.bench-bar {
		margin-top: 4px;
		height: 6px;
		background: var(--paper-2);
		border-radius: 999px;
		overflow: hidden;
	}
	.bench-bar__fill {
		display: block;
		height: 100%;
		border-radius: 999px;
	}

	.model-detail__notes p {
		font-family: var(--font-body);
		font-size: 16px;
		line-height: 1.65;
		color: var(--ink-900);
		margin: 0;
	}

	.model-detail__article {
		padding: 0;
	}
	.model-detail__article-kicker {
		display: block;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 11px;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--violet-600);
		margin-bottom: 10px;
	}
	.model-detail__article-card {
		display: block;
		text-decoration: none;
		color: inherit;
		padding: 22px 24px;
		background: var(--violet-50);
		border: 1px solid var(--violet-100);
		border-radius: 14px;
		transition: border-color 120ms;
	}
	.model-detail__article-card:hover {
		border-color: var(--violet-500);
	}
	.model-detail__article-card h3 {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 18px;
		line-height: 1.3;
		color: var(--ink-900);
		margin: 0 0 8px;
	}
	.model-detail__article-card p {
		font-family: var(--font-body);
		font-size: 14px;
		line-height: 1.55;
		color: var(--ink-700);
		margin: 0 0 10px;
	}
	.model-detail__article-cta {
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 12px;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: var(--violet-600);
	}

	.model-detail__source-link {
		font-family: var(--font-mono);
		font-size: 13px;
		color: var(--violet-600);
		word-break: break-all;
	}

	.family-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.family-item {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		text-decoration: none;
		padding: 10px 14px;
		border-radius: 8px;
		color: inherit;
		transition: background 120ms;
	}
	.family-item:hover {
		background: var(--paper-2);
	}
	.family-item__name {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 14px;
		color: var(--ink-900);
	}
	.family-item__date {
		font-family: var(--font-body);
		font-size: 12px;
		color: var(--ink-500);
	}

	@media (max-width: 720px) {
		.model-detail__hero h1 {
			font-size: 26px;
		}
	}
</style>
