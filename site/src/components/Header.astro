---
const navItems = [
	{ href: '/', label: 'Главная' },
	{ href: '/blog/', label: 'Архив' },
	{ href: '/models/', label: 'Релизы' },
	{ href: '/digest/', label: 'Дайджест' },
	{ href: '/curated/', label: 'Подборка' },
	{ href: '/glossary/', label: 'Словарь' },
	{ href: '/about/', label: 'О проекте' },
];

const currentPath = Astro.url.pathname;
---

<header class="nav-wrap">
	<div class="container">
		<div class="nav-row1">
			<a class="nav-logo" href="/" aria-label="SCQR.RU — на главную">
				SCQ<span class="ru">R.RU</span>
			</a>
			<span class="nav-tagline">аналитика рынка<br />искусственного интеллекта</span>
			<span class="nav-actions">
				<button class="nav-icon-btn nav-search-icon" aria-label="Поиск" type="button">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<circle cx="11" cy="11" r="7" />
						<path d="m21 21-4.3-4.3" />
					</svg>
				</button>
				<button class="nav-icon-btn nav-theme-toggle" aria-label="Переключить тему" type="button" data-theme-toggle>
					<svg class="nav-theme-toggle__icon nav-theme-toggle__icon--moon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
					</svg>
					<svg class="nav-theme-toggle__icon nav-theme-toggle__icon--sun" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<circle cx="12" cy="12" r="4" />
						<path d="M12 2v2" />
						<path d="M12 20v2" />
						<path d="M4.93 4.93l1.41 1.41" />
						<path d="M17.66 17.66l1.41 1.41" />
						<path d="M2 12h2" />
						<path d="M20 12h2" />
						<path d="M6.34 17.66l-1.41 1.41" />
						<path d="M19.07 4.93l-1.41 1.41" />
					</svg>
				</button>
				<a href="https://t.me/scqr_ai" class="nav-cta" target="_blank" rel="noopener">Подписаться</a>
				<a class="nav-avatar" href="/about/" aria-label="О проекте">
					<img src="/editorial/2026-refresh/mascot/mascot_avatar_transparent.png" alt="" width="38" height="38" loading="lazy" />
				</a>
			</span>
		</div>
		<nav class="nav-row2" aria-label="Разделы">
			{
				navItems.map((item) => {
					const isActive =
						item.href === '/'
							? currentPath === '/'
							: currentPath === item.href || currentPath.startsWith(item.href);
					return (
						<a href={item.href} class={isActive ? 'active' : ''}>
							{item.label}
						</a>
					);
				})
			}
		</nav>
	</div>
</header>

<style>
	/* TopNav — ported from Claude Design handoff (ui_kits/website/site.css) */
	.nav-wrap {
		position: sticky;
		top: 0;
		z-index: 50;
		background: var(--nav-bg, rgba(255, 255, 255, 0.95));
		backdrop-filter: blur(8px);
		-webkit-backdrop-filter: blur(8px);
		border-bottom: 1px solid var(--line);
	}
	:global([data-theme='dark']) .nav-wrap {
		background: rgba(14, 17, 22, 0.92);
	}
	.nav-row1 {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 14px 0;
	}
	.nav-logo {
		font-family: var(--font-display);
		font-weight: 800;
		font-size: 22px;
		letter-spacing: -0.025em;
		color: var(--ink-900);
		line-height: 1;
		text-decoration: none;
	}
	.nav-logo .ru {
		color: var(--violet-500);
	}
	.nav-tagline {
		font-family: var(--font-body);
		font-size: 12px;
		color: var(--ink-500);
		max-width: 150px;
		line-height: 1.3;
	}
	.nav-actions {
		margin-left: auto;
		display: flex;
		align-items: center;
		gap: 12px;
	}
	.nav-icon-btn {
		width: 36px;
		height: 36px;
		border-radius: 50%;
		border: 1px solid var(--line);
		background: var(--bg-card, #fff);
		display: flex;
		align-items: center;
		justify-content: center;
		color: var(--ink-700);
		cursor: pointer;
		transition: border-color 120ms, color 120ms, background 120ms;
		padding: 0;
	}
	.nav-icon-btn:hover {
		border-color: var(--line-strong);
		color: var(--violet-600);
	}

	.nav-theme-toggle {
		position: relative;
	}
	.nav-theme-toggle__icon {
		position: absolute;
		top: 50%;
		left: 50%;
		transform: translate(-50%, -50%);
		transition: opacity 160ms ease, transform 200ms ease;
	}
	.nav-theme-toggle__icon--sun {
		opacity: 0;
		transform: translate(-50%, -50%) rotate(-90deg) scale(0.6);
	}
	:global([data-theme='dark']) .nav-theme-toggle__icon--moon {
		opacity: 0;
		transform: translate(-50%, -50%) rotate(90deg) scale(0.6);
	}
	:global([data-theme='dark']) .nav-theme-toggle__icon--sun {
		opacity: 1;
		transform: translate(-50%, -50%) rotate(0deg) scale(1);
	}
	@media (prefers-reduced-motion: reduce) {
		.nav-theme-toggle__icon {
			transition: none;
		}
	}
	.nav-cta {
		border: 1px solid var(--violet-500);
		background: #fff;
		color: var(--violet-600);
		border-radius: 999px;
		font-family: var(--font-display);
		font-weight: 700;
		font-size: 14px;
		padding: 8px 18px;
		cursor: pointer;
		text-decoration: none;
		transition: background 120ms, color 120ms;
	}
	.nav-cta:hover {
		background: var(--violet-500);
		color: #fff;
	}
	.nav-avatar {
		width: 38px;
		height: 38px;
		border-radius: 50%;
		overflow: hidden;
		background: var(--paper-3);
		border: 1px solid var(--line);
		display: block;
	}
	.nav-avatar img {
		width: 130%;
		height: auto;
		max-width: none;
		transform: translate(-12%, 8%);
	}
	.nav-row2 {
		display: flex;
		gap: 22px;
		padding: 0 0 12px;
		flex-wrap: wrap;
	}
	.nav-row2 a {
		font-family: var(--font-display);
		font-weight: 600;
		font-size: 14px;
		color: var(--ink-900);
		text-decoration: none;
		padding: 4px 0;
		transition: color 120ms;
	}
	.nav-row2 a.active {
		color: var(--violet-600);
	}
	.nav-row2 a:hover {
		color: var(--violet-600);
	}

	@media (max-width: 720px) {
		.nav-tagline {
			display: none;
		}
		.nav-row2 {
			gap: 14px;
			overflow-x: auto;
			-webkit-overflow-scrolling: touch;
			padding-bottom: 12px;
		}
		.nav-row2 a {
			white-space: nowrap;
		}
	}
</style>

<script>
	function init() {
		const buttons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
		if (!buttons.length) return;

		const apply = (theme: 'light' | 'dark') => {
			document.documentElement.setAttribute('data-theme', theme);
			try {
				localStorage.setItem('scqr-theme', theme);
			} catch {
				/* localStorage недоступен — переключение работает только в текущей сессии */
			}
			// Сообщаем кнопке о текущем состоянии для screen readers.
			buttons.forEach((btn) => {
				btn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
				btn.setAttribute(
					'title',
					theme === 'dark' ? 'Переключить на светлую тему' : 'Переключить на тёмную тему',
				);
			});
		};

		const current =
			document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
		apply(current);

		buttons.forEach((btn) => {
			btn.addEventListener('click', () => {
				const next =
					document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
				apply(next);
			});
		});
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
</script>
